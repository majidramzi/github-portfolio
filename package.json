{
  "name": "github-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Dynamic, forkable GitHub Portfolio Generator powered by the GitHub REST API and GitHub Pages",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^1.73.0",
    "marked": "^15.0.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
